{
  "info": {
    "name": "MERN Investment Platform API",
    "description": "API collection for auth, investments, dashboard, and referral endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"mobileNumber\": \"9876543210\",\n  \"password\": \"secret123\",\n  \"referralCode\": \"INVEST22\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "auth", "register"]
        }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"secret123\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "Investment - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 5000,\n  \"planDetails\": \"Premium Growth\",\n  \"startDate\": \"2026-11-01\",\n  \"endDate\": \"2027-01-01\",\n  \"dailyROI\": 1.5\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/investments",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "investments"]
        }
      }
    },
    {
      "name": "Investment - List",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "http://localhost:5000/api/investments",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "investments"]
        }
      }
    },
    {
      "name": "Dashboard",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "http://localhost:5000/api/dashboard",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "dashboard"]
        }
      }
    },
    {
      "name": "Referrals - Direct",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "http://localhost:5000/api/referrals/direct",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "referrals", "direct"]
        }
      }
    },
    {
      "name": "Referrals - Tree",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "http://localhost:5000/api/referrals/tree",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "referrals", "tree"]
        }
      }
    }
  ],
  "variable": [
    { "key": "token", "value": "paste_jwt_here" }
  ]
}
